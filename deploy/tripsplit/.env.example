# Copy this file to .env and adjust the values. docker compose reads .env.
# Wrap a value in single quotes if it contains $, otherwise Compose treats $ as a variable and drops part of it.

# ---- Image and port ----
# The LuyFlow version to run. Change the tag to upgrade. OAuth needs 0.2 or later.
LUYFLOW_IMAGE=ghcr.io/samnang-vouen/luyflow:0.2
# Port on your machine. Use another one (e.g. 3002) if TripSplit already uses 3001.
LUYFLOW_PORT=3001

# ---- App ----
# development keeps the Swagger docs at http://localhost:3001/api
NODE_ENV=development
# Comma-separated browser origins allowed to call the API. Empty allows any origin.
CORS_ORIGIN=

# ---- Database ----
# Pick any values. The PostgreSQL container is created with them on first start.
# Changing them later needs a fresh database: docker compose down -v (deletes all data).
DATABASE_USER=luyflow
DATABASE_PASSWORD=
DATABASE_NAME=luyflow

# ---- Login tokens ----
# Two different long random strings, e.g. from: openssl rand -hex 32
# Changing them logs every user out.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Lifetimes in seconds: access 15 minutes, refresh 7 days.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---- OAuth ("Connect LuyFlow") ----
# The one app allowed to connect to LuyFlow accounts. Leave OAUTH_CLIENT_SECRET empty to turn OAuth off.
# Use the same three values in TripSplit: LUYFLOW_CLIENT_ID, LUYFLOW_CLIENT_SECRET, LUYFLOW_REDIRECT_URI.
OAUTH_CLIENT_ID=tripsplit
# A long random string, e.g. from: openssl rand -hex 32
OAUTH_CLIENT_SECRET=
# TripSplit's callback. Must match exactly what TripSplit sends as redirect_uri.
OAUTH_REDIRECT_URI=https://34-87-166-91.sslip.io/api/v1/integrations/luyflow/callback
# Shown on the consent page: "<name> wants to see and add to your savings goals".
OAUTH_CLIENT_NAME=TripSplit
