# Copy to .env and fill in the empty required values. Never commit .env.
# Used both by `npm run start:dev` and by `docker compose` (compose.yaml).
# Wrap a value in single quotes if it contains $ (Docker Compose would read $ as a variable).

PORT=3000
NODE_ENV=development
# Host port for `docker compose` (the API listens on 3000 inside the container).
API_PORT=3000

# Comma-separated browser origins allowed to call the API.
# Leave empty in development to reflect any origin; set it in production.
CORS_ORIGIN=

# ---- Database ----
# Running with Docker: HOST and PORT are ignored (compose uses its own Postgres container),
#   and USER, PASSWORD and NAME create that database on first start. All three are required.
# Running without Docker: point HOST and PORT at your own PostgreSQL, e.g. localhost and 5432.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=luyflow
DATABASE_PASSWORD=
DATABASE_NAME=luyflow

# ---- Login tokens (required) ----
# Two different long random strings, e.g. from: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=604800

# ---- Redis (background jobs) ----
# Ignored with Docker (compose uses its own Redis container).
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- OAuth client allowed to connect to LuyFlow accounts (TripSplit) ----
# Leave OAUTH_CLIENT_SECRET empty to turn /oauth/* off. The secret is shared privately, never committed.
OAUTH_CLIENT_ID=tripsplit
OAUTH_CLIENT_SECRET=
# Must match TripSplit's callback URL exactly.
OAUTH_REDIRECT_URI=
OAUTH_CLIENT_NAME=TripSplit
