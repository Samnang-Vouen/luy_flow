PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
# Leave empty in development to reflect any origin; set it in production.
CORS_ORIGIN=

DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=604800

REDIS_HOST=localhost
REDIS_PORT=6379

# OAuth client allowed to connect to LuyFlow accounts (TripSplit).
# Leave empty to turn /oauth/* off. The secret is shared privately with TripSplit, never committed.
OAUTH_CLIENT_ID=tripsplit
OAUTH_CLIENT_SECRET=
# Must match TripSplit's callback URL exactly.
OAUTH_REDIRECT_URI=
OAUTH_CLIENT_NAME=TripSplit